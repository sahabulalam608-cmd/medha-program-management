# ============================================================
# Medha Program Management — security & caching headers
# Cloudflare Pages / Netlify read this file automatically.
# ============================================================

/*
  # --- Content Security Policy -----------------------------------
  # script-src  : the portal's own files + the Google Sheets JSONP reader
  #              + one small inline script in index.html
  # style-src   : the portal's own styles + inline styles + Google Fonts
  # frame-src   : the two payment consoles and the support desk
  # connect-src : Google Sheets (read) + Apps Script backend
  #              + script.googleusercontent.com (GAS redirect target — required)
  # img-src     : inline images, the media the portal draws, and blobs
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://docs.google.com https://script.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://docs.google.com https://script.google.com https://script.googleusercontent.com https://*.googleapis.com; frame-src 'self' https://otanextchapter.online https://pay.onlinetechacademy.club https://app.medha.pro; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

  # --- Basics -----------------------------------------------------
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # --- Caching ---------------------------------------------------
  Cache-Control: no-cache
